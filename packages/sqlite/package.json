{
  "$schema": "https://json.schemastore.org/package",
  "name": "@mark1russell7/sqlite",
  "version": "0.3.8",
  "description": "Databases on one computer through node:sqlite: the pragmas, migrations by schema version, BEGIN IMMEDIATE transactions, a typed append-only event log as a grow-only set, the faults of SQLite, the recovery of a broken file and a filter of the experimental warning.",
  "keywords": [
    "sqlite",
    "node:sqlite",
    "wal",
    "migrations",
    "user_version",
    "transaction",
    "event-log",
    "append-only",
    "event-sourcing",
    "typescript",
    "grow-only-set",
    "crdt",
    "error-codes",
    "recovery",
    "backup"
  ],
  "homepage": "https://github.com/mark1russell7/sqlite/tree/main/packages/sqlite#readme",
  "bugs": {
    "url": "https://github.com/mark1russell7/sqlite/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mark1russell7/sqlite.git",
    "directory": "packages/sqlite"
  },
  "license": "MIT",
  "author": "Mark Russell (https://github.com/mark1russell7)",
  "type": "module",
  "sideEffects": false,
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./warning": "./src/warning.ts",
    "./portable": "./src/portable.ts",
    "./package.json": "./package.json"
  },
  "files": [
    "build"
  ],
  "publishConfig": {
    "access": "public",
    "main": "./build/index.js",
    "types": "./build/index.d.ts",
    "exports": {
      ".": {
        "types": "./build/index.d.ts",
        "import": "./build/index.js",
        "default": "./build/index.js"
      },
      "./warning": {
        "types": "./build/warning.d.ts",
        "import": "./build/warning.js",
        "default": "./build/warning.js"
      },
      "./portable": {
        "types": "./build/portable.d.ts",
        "import": "./build/portable.js",
        "default": "./build/portable.js"
      },
      "./package.json": "./package.json"
    }
  },
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "build": "tsdown",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.test.json && tsc -p tsconfig.node22.json",
    "test:crash": "vitest run --config vitest.crash.config.ts",
    "test:power": "vitest run --config vitest.power.config.ts"
  },
  "devDependencies": {
    "@mark1russell7/cue": "^2.0.0",
    "@mark1russell7/harness": "^0.16.5",
    "@mark1russell7/rigor-bench": "^0.2.52",
    "@mark1russell7/rigor-chaos": "^0.3.3",
    "@mark1russell7/rigor-generators": "^0.1.17",
    "@mark1russell7/rigor-statistics": "^0.2.7",
    "@mark1russell7/rigor-testkit": "^0.1.12",
    "@sqlite.org/sqlite-wasm": "3.54.1-build1",
    "@types/node": "^26.6.5",
    "@types/node-22": "npm:@types/node@22.20.5",
    "@types/sql.js": "^1.4.11",
    "@vitest/coverage-v8": "^5.0.3",
    "esbuild": "^0.28.2",
    "fast-check": "^4.10.2",
    "sql.js": "1.14.2",
    "tsdown": "^0.23.7",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3",
    "zod": "4.6.7"
  }
}
